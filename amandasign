.mandy{
  width:240px;
  height:210px;
  box-sizing:border-box;
  position:relative;
  display:flex;
  align-items:center;
  justify-content:center;
  border:1.2px dotted #5e5e5e;
  overflow:visible;
  transition:border-color .8s ease;
  transition:border-radius .8s ease
}

.mandy:hover{
  border-color:#404736;
  border-radius: 10px;
}

.mandyimg{
  width:210px;
  height:180px;
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  overflow:hidden;
  object-fit:cover;
  display:block; 
  filter: brightness(1) contrast(1.2);
  transition: 1s ease;
}

.mandyimg img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.mandy:hover .mandyimg{
  filter: brightness(0.6) contrast(1.1);
  transition: 2s ease;
}

.mandytop,
.mandybottom{
  position:absolute;
  width:210px;
  text-align:center;
  color:#9e9e9e;
  font-family:'Fathan',sans-serif;
  font-size:8px;
  line-height:8px;
  letter-spacing:2px;
  text-transform:uppercase;
  text-shadow: 0.5px 0.5px 0.5px #2e5931;
  transition: opacity .3s ease, transform .6s ease;
}

.mandytop{
 bottom:30px;
 right:12%;
}

.mandybottom{
  bottom:20px;
  left:12%;
}

.mandy:hover .mandytop{
  opacity:0;
  transform: translateY(-8px);
}

.mandy:hover .mandybottom{
  opacity:0;
  transform: translateY(8px);
}

.mandy:not(:hover) .mandytop{
  transition-delay:.7s;
}

.mandy:not(:hover) .mandybottom{
  transition-delay:.7s;
}

.mandytext{
  position: absolute;
  width:210px;
  top:10%;
  color:#c2c2c2;
  font-family:'Fathan',sans-serif;
  font-size:8px;
  letter-spacing:2px;
  text-align:right;
  right:8%;
  text-transform:uppercase;
  opacity:0;
  transform:translateX(9px);
  transition: opacity .25s ease, transform .6s ease;
}

.mandysub{
  position: absolute;
  width:210px;
  bottom: 9%;
  color:#c2c2c2;
  font-family:'Fathan',sans-serif;
  font-size:8px;
  letter-spacing:2px;
  text-align:left;
  left:9%;
  text-transform:uppercase;
  opacity:0;
  transform:translateX(-10px);
  transition:
    opacity .25s ease,
    transform .6s ease;
}

.mandy:hover .mandytext{
  opacity:1;
  transform:translateX(0);
  transition-delay:.75s;
}

.mandy:hover .mandysub{
  opacity:1;
  transform:translateX(0);
  transition-delay:.75s;
}

.mandylinea {
  position:absolute;
  height:1.2px !important;
  background: linear-gradient(to left, transparent, rgba(96, 103, 87, 1), transparent);
  left:6%;
  top:11%;
  opacity:0;
  transition:
    width .4s ease,
    opacity .4s ease;
}

.mandy:hover .mandylinea {
  width:87px;
  height:1.5px;
  opacity:1;
}

.mandylinea2 {
  position:absolute;
  height:1px;
  background: linear-gradient(to left, transparent, rgba(96, 103, 87, 1), transparent);
  right:7%;
  bottom:11.2%;
  opacity:0;
  transition:
    width .4s ease,
    opacity .4s ease;
}

.mandy:hover .mandylinea2 {
  width:65px;
  height:1px;
  opacity:1;
}

.mandyicon{
  position:absolute;
  top:49%;
  left:50%;
  width:40px;
  height:40px;
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:10;
  opacity:0;
  transform:translate(-50%,-50%) scale(.75);
  transition:
    opacity .8s ease,
    transform .8s ease;
}

.mandyicon i{
  position:static!important;
  display:block!important;
  color:#606757;
  font-size:40px;
  line-height:1;
}

.mandy:hover .mandyicon{
  opacity:1;
  transform:translate(-50%,-50%) scale(1);
  transition-delay:.75s;
}
